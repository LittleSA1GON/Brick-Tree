# Brick Tree — stateless Vercel runtime
NODE_ENV=development

# Hosted default: Groq free tier
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Optional fallback: groq | openai-compatible
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Generic OpenAI-compatible endpoint (local or hosted)
# Examples include Gemini/OpenAI-compat, OpenRouter, Ollama, LM Studio, llama.cpp, LocalAI, vLLM.
LLM_API_KEY=
LLM_BASE_URL=

# Optional general web search. If omitted, Wikipedia + Crossref still work without keys.
TAVILY_API_KEY=
APP_CONTACT_EMAIL=

# Optional agentic RAG HTTP service. If omitted, knowledge-base retrieval is disabled.
LOCAL_RAG_BASE_URL=

AGENT_MAX_STEPS=5
AGENT_MAX_REVISIONS=2
