# Brick Tree — stateless local/Vercel runtime
LLM_PROVIDER=auto

# Hosted providers. Configure at least two when possible so one provider can
# cool down while another continues the request.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional additional free quota pool: Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# Optional last fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional explicit fallback when LLM_PROVIDER is not auto.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Optional generic OpenAI-compatible endpoint.
# Cerebras: https://api.cerebras.ai/v1 with model gpt-oss-120b
# Local Ollama: http://localhost:11434/v1 with LLM_API_KEY=local
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional per-role routing: groq | gemini | cloudflare | openrouter | openai-compatible
CONCEPT_ARCHITECT_PROVIDER=
LEARNING_PATH_PROVIDER=
PEDAGOGY_VALIDATOR_PROVIDER=
RESOURCE_AGENT_PROVIDER=
EXPLANATION_PROVIDER=

# Optional search/research integrations.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
APP_CONTACT_EMAIL=

# Optional agentic RAG endpoint. Do not use localhost/private LAN URLs on Vercel.
LOCAL_RAG_BASE_URL=

# Bounded runtime / free-tier protection.
AGENT_MAX_STEPS=5
AGENT_MAX_REVISIONS=1

# Keep model completions compact. This is especially important for Groq's
# free gpt-oss token-per-minute budget.
LLM_MAX_OUTPUT_TOKENS=1000

# Provider circuit-breaker defaults. Retry-After from the provider overrides
# this value; repeated 429 responses increase the cooldown automatically.
LLM_PROVIDER_COOLDOWN_SECONDS=90

# Per-provider spacing inside each warm Vercel instance. Auto routing selects
# another ready provider before waiting when one has a scheduled slot.
LLM_MIN_PROVIDER_INTERVAL_MS=5000
GROQ_MIN_PROVIDER_INTERVAL_MS=10000
GEMINI_MIN_PROVIDER_INTERVAL_MS=4000
CLOUDFLARE_MIN_PROVIDER_INTERVAL_MS=3000
OPENROUTER_MIN_PROVIDER_INTERVAL_MS=6000

# Avoid extra model calls for routine validation/resource planning.
PEDAGOGY_VALIDATION_MODE=deterministic
RESOURCE_PLANNING_MODE=deterministic
